<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <EditText
        android:id="@+id/et_chi_phi_nguyen_lieu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Chi phí nguyên liệu (VNĐ)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_gia_bao_gia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giá báo cho khách (VNĐ)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_thong_tin_bao_gia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Thông tin mô tả thêm (tuỳ chọn)"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top"
        android:layout_marginBottom="12dp" />
</LinearLayout>
